# Simple Makefile for systems with sdl2-config (Linux, macOS/Homebrew, MSYS2).
# For everything else use CMake (see README.md).

CC      ?= cc
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS   := $(shell sdl2-config --libs)
CFLAGS  ?= -O2 -Wall -Wextra
CFLAGS  += -std=c99 $(SDL_CFLAGS)

SRC = src/main.c src/game.c src/platform.c src/modplayer.c src/files.c src/pklite.c
OBJ = $(SRC:.c=.o)

invataxi: $(OBJ)
	$(CC) -o $@ $(OBJ) $(SDL_LIBS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJ) invataxi invataxi.exe

.PHONY: clean
